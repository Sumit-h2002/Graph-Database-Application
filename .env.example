# ==============================================================================
# Graph Database Cloud Benchmarking - Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Global Benchmark Environment Settings
BENCHMARK_ENV=development
BENCHMARK_LOG_LEVEL=INFO
BENCHMARK_RANDOM_SEED=42

# ------------------------------------------------------------------------------
# 1. CognDB Cloud (Neo4j / Bolt compatible)
# ------------------------------------------------------------------------------
COGNODB_URI=bolt://localhost:7687
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your_cognodb_password_here
COGNODB_DATABASE=neo4j
COGNODB_ENCRYPTED=false

# ------------------------------------------------------------------------------
# 2. Neo4j (Self-Hosted / Aura Cloud)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
NEO4J_ENCRYPTED=false

# ------------------------------------------------------------------------------
# 3. Memgraph (Bolt Protocol)
# ------------------------------------------------------------------------------
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_ENCRYPTED=false

# ------------------------------------------------------------------------------
# 4. FalkorDB (Redis Graph Protocol)
# ------------------------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=benchmark_graph

# ------------------------------------------------------------------------------
# 5. Kùzu (Embedded / Server Graph Database)
# ------------------------------------------------------------------------------
KUZU_DATABASE_PATH=data/kuzu_db
KUZU_BUFFER_POOL_SIZE_GB=1

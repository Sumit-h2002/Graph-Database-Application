# ==============================================================================
# Graph Database Cloud Benchmarking - Environment Configuration Template
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env          (Linux/macOS)
#    copy .env.example .env        (Windows)
# 2. Fill in your database endpoints and credentials in .env.
# 3. NEVER commit your actual .env file to version control.
# ==============================================================================

# Global benchmark settings
BENCHMARK_ENV=development
BENCHMARK_LOG_LEVEL=INFO
BENCHMARK_RANDOM_SEED=42

# CognDB Cloud
COGNODB_URI=
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=
COGNODB_DATABASE=neo4j

# Neo4j
NEO4J_URI="neo4j+s://6f505e3f.databases.neo4j.io"
NEO4J_USERNAME=itiprajwal8@gmail.com
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Memgraph
MEMGRAPH_URI=
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# FalkorDB
FALKORDB_URI=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Fifth database (Kùzu / Columnar / Embedded)
DATABASE5_URI=
DATABASE5_USERNAME=
DATABASE5_PASSWORD=
KUZU_DATABASE_PATH=data/kuzu_db
KUZU_BUFFER_POOL_SIZE_GB=1.0
